{
  "name": "@cognitiveos/dsh-akp-adapter",
  "version": "0.0.1",
  "private": true,
  "description": "Candidate-only DeepSeek Harness (dsh) bridge to the CognitiveOS AKP boundary",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"dist/*.test.js\" \"scripts/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "Apache-2.0"
}
