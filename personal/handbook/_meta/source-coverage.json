{
  "schema": "cognitiveos-handbook-coverage/0.1",
  "description": "Total classification of every Git-tracked repository path. tools/src/check-handbook.mjs expands `git ls-files` against these rules: every tracked path must match at least one rule (first match wins, top to bottom). A new first-party file that matches no rule fails the handbook check until it is classified here. Categories `excluded-*` need a reason; category `first-party-source` needs at least one owning doc_id; documentation categories point at their own system.",
  "categories": {
    "handbook": "the handbook system itself (validated by manifest/frontmatter checks)",
    "subproject": "sibling subproject tree under ADR-0054 (clients/, enterprise/) governed by its own documentation; the handbook documents the Personal product and its core contracts only",
    "first-party-source": "live first-party implementation, contract, test, or tooling text mapped to handbook docs",
    "legacy-docs": "pre-existing documentation system (governance/plan/product/architecture/ADR/checkpoints/prompts); canonical or historical sources the handbook links to but never duplicates or edits",
    "excluded-lock-payload": "machine dependency lock payload without documentation semantics",
    "excluded-frozen-history": "frozen History/ archive; reading or citing is forbidden by repository governance",
    "generated-bindings": "committed generator output; regenerated, never hand-edited; described by dev.contracts-codegen"
  },
  "rules": [
    { "glob": "History/**", "category": "excluded-frozen-history", "reason": "docs/governance prohibition: never read or cite History/" },
    { "glob": "Cargo.lock", "category": "excluded-lock-payload", "reason": "cargo dependency lock; no documentation semantics" },
    { "glob": "pnpm-lock.yaml", "category": "excluded-lock-payload", "reason": "pnpm dependency lock; no documentation semantics" },

    { "glob": "personal/handbook/**", "category": "handbook", "docs": ["meta.doc-standards"] },
    { "glob": "llms.txt", "category": "handbook", "docs": ["ai.entry"] },
    { "glob": ".githooks/**", "category": "first-party-source", "docs": ["meta.sync-policy", "ai.docs-impact", "dev.contributing-workflow"] },

    { "glob": "core/crates/cognitive-contracts/src/generated/**", "category": "generated-bindings", "docs": ["dev.contracts-codegen"] },
    { "glob": "core/packages/contracts-ts/src/generated/**", "category": "generated-bindings", "docs": ["dev.contracts-codegen"] },
    { "glob": "docs/traceability/matrix.yaml", "category": "generated-bindings", "docs": ["dev.conformance-testing"] },
    { "glob": "core/tests/golden/*.json", "category": "generated-bindings", "docs": ["dev.contracts-codegen"] },

    { "glob": "core/crates/cognitive-kernel/**", "category": "first-party-source", "docs": ["dev.authority-kernel", "dev.task-pipeline", "dev.context-artifact"] },
    { "glob": "personal/crates/cognitive-store/**", "category": "first-party-source", "docs": ["dev.store-migrations", "dev.memory-skill", "dev.execution-chain-status", "user.provider-control-plane"] },
    { "glob": "personal/crates/cognitive-runtime/**", "category": "first-party-source", "docs": ["dev.installer-service", "dev.agent-pi-lifecycle", "dev.performance-perf", "dev.execution-chain-status", "user.getting-started"] },
    { "glob": "core/crates/cognitive-domain/**", "category": "first-party-source", "docs": ["dev.authority-kernel", "ref.transitions"] },
    { "glob": "core/crates/cognitive-akp/**", "category": "first-party-source", "docs": ["dev.clients-ts", "ref.http-api"] },
    { "glob": "personal/crates/cognitive-management/**", "category": "first-party-source", "docs": ["dev.management-plane", "ref.cli-admin"] },
    { "glob": "personal/crates/cognitive-secret/**", "category": "first-party-source", "docs": ["user.provider-and-secrets", "user.provider-control-plane", "dev.daemon-http-surface"] },
    { "glob": "personal/crates/cognitive-provider-transport/**", "category": "first-party-source", "docs": ["user.provider-and-secrets", "user.provider-control-plane", "dev.daemon-http-surface"] },
    { "glob": "personal/crates/cognitive-conformance/**", "category": "first-party-source", "docs": ["dev.conformance-testing"] },
    { "glob": "core/crates/cognitive-contracts/**", "category": "first-party-source", "docs": ["dev.contracts-codegen"] },

    { "glob": "personal/apps/kernel-server/**", "category": "first-party-source", "docs": ["dev.daemon-http-surface", "dev.task-pipeline", "ref.http-api", "user.provider-control-plane", "user.system-overview"] },
    { "glob": "personal/apps/admin-cli/**", "category": "first-party-source", "docs": ["user.cli-basics", "user.provider-control-plane", "user.getting-started", "ref.cli-cognitive", "ref.cli-admin"] },
    { "glob": "personal/apps/pi-agent-adapter/**", "category": "first-party-source", "docs": ["dev.agent-pi-lifecycle", "user.pi-shell"] },
    { "glob": "personal/apps/agent-shell/**", "category": "first-party-source", "docs": ["dev.clients-ts"] },
    { "glob": "clients/legacy/cognitiveos-console/**", "category": "legacy-docs", "reason": "deprecated compatibility stubs pointing at the external cognitiveos-clients repository (CLIENTS-DEC-001)" },

    { "glob": "personal/packages/pi-cognitiveos/**", "category": "first-party-source", "docs": ["user.pi-shell", "dev.clients-ts"] },
    { "glob": "personal/packages/dsh-akp-adapter/**", "category": "first-party-source", "docs": ["dev.agent-pi-lifecycle", "dev.performance-perf"] },
    { "glob": "personal/packages/sdk-ts/**", "category": "first-party-source", "docs": ["dev.clients-ts"] },
    { "glob": "core/packages/contracts-ts/**", "category": "first-party-source", "docs": ["dev.contracts-codegen"] },

    { "glob": "core/specs/registry/**", "category": "first-party-source", "docs": ["ref.errors", "ref.schemas", "dev.contracts-codegen"] },
    { "glob": "core/specs/transitions/**", "category": "first-party-source", "docs": ["ref.transitions"] },
    { "glob": "core/specs/schemas/**", "category": "first-party-source", "docs": ["ref.schemas"] },
    { "glob": "core/specs/**", "category": "first-party-source", "docs": ["dev.architecture-overview", "ai.source-of-truth"] },

    { "glob": "core/conformance/**", "category": "first-party-source", "docs": ["dev.conformance-testing"] },
    { "glob": "core/tests/**", "category": "first-party-source", "docs": ["dev.dev-environments", "dev.conformance-testing"] },
    { "glob": "personal/tests/**", "category": "first-party-source", "docs": ["dev.dev-environments", "dev.conformance-testing"] },
    { "glob": "tools/**", "category": "first-party-source", "docs": ["dev.conformance-testing", "meta.sync-policy"] },
    { "glob": "personal/deploy/**", "category": "first-party-source", "docs": ["user.install-first-conversation", "user.getting-started", "dev.installer-service"] },
    { "glob": "scripts/**", "category": "first-party-source", "docs": ["dev.dev-environments"] },
    { "glob": ".github/**", "category": "first-party-source", "docs": ["dev.contributing-workflow", "dev.dev-environments"] },
    { "glob": ".cursor/rules/**", "category": "legacy-docs", "reason": "editor adapter rules owned by repository governance; the handbook sync rule is registered separately" },
    { "glob": ".cursor/environment.json", "category": "first-party-source", "docs": ["dev.dev-environments"] },

    { "glob": "docs/governance/**", "category": "legacy-docs", "reason": "canonical governance sources; handbook links, never duplicates" },
    { "glob": "docs/plan/**", "category": "legacy-docs", "reason": "formal plan, current snapshot, lease ledger, environments; dynamic status is never copied into the handbook" },
    { "glob": "docs/product/**", "category": "legacy-docs", "reason": "canonical stable product design" },
    { "glob": "docs/architecture/**", "category": "legacy-docs", "reason": "informative target architecture" },
    { "glob": "core/docs/**", "category": "legacy-docs", "reason": "CognitiveOS architecture whitepapers/RFCs and the core 1.0.0 version boundary (informative; ADR-0054)" },
    { "glob": "personal/docs/product/legacy-agent-stewardship-20260827/**", "category": "legacy-docs", "reason": "frozen superseded Personal 2.0 agent-stewardship product corpus; not current semantics" },
    { "glob": "personal/docs/**", "category": "legacy-docs", "reason": "canonical stable Personal product/architecture design and the personal 1.0.0 version boundary (ADR-0054)" },
    { "glob": "clients/docs/design/legacy-control-plane-20260827/**", "category": "subproject", "reason": "frozen pre-OPC client design/as-built audit corpus retained for provenance" },
    { "glob": "clients/docs/design/opc-2.0/**", "category": "subproject", "reason": "current Personal 2.0 OPC interaction design in the clients subproject; target design, not handbook truth" },
    { "glob": "clients/**", "category": "subproject", "reason": "imported cognitiveos-clients subproject (ADR-0054 fold-in); own governance and plans" },
    { "glob": "enterprise/**", "category": "subproject", "reason": "cognitiveos-enterprise design layer (ADR-0054); not an active implementation project" },
    { "glob": ".cursor/skills/**", "category": "legacy-docs", "reason": "editor workspace design skills (Cursor tooling); not product source" },
    { "glob": "docs/adr/**", "category": "legacy-docs", "reason": "accepted/proposed decision records" },
    { "glob": "docs/standards/**", "category": "legacy-docs", "reason": "normative behavior standards; contract-class sources" },
    { "glob": "docs/checkpoints/**", "category": "legacy-docs", "reason": "dated evidence/handoffs; historical, not current status" },
    { "glob": "docs/prompts/**", "category": "legacy-docs", "reason": "dated non-executable prompts" },
    { "glob": "docs/evaluation/**", "category": "legacy-docs", "reason": "evaluation/benchmark design sources" },
    { "glob": "docs/traceability/**", "category": "legacy-docs", "reason": "traceability ledger and findings" },
    { "glob": "docs/legal/**", "category": "legacy-docs", "reason": "third-party notices" },
    { "glob": "docs/bug/**", "category": "legacy-docs", "reason": "dated product diagnostics and recovery notes; current product status remains in PROGRESS.md" },
    { "glob": "docs/clients/**", "category": "legacy-docs", "reason": "deprecated stub pointing at external clients repository" },
    { "glob": "clients/docs/platforms/**", "category": "legacy-docs", "reason": "deprecated stub pointing at external clients repository" },
    { "glob": "docs/research/**", "category": "legacy-docs", "reason": "documentation-only research reviews" },
    { "glob": "docs/README.md", "category": "legacy-docs", "reason": "legacy documentation map" },

    { "glob": "AGENTS.md", "category": "legacy-docs", "reason": "agent entry document; handbook adds one pointer only" },
    { "glob": "README.md", "category": "legacy-docs", "reason": "repository root readme" },
    { "glob": "LICENSE", "category": "legacy-docs", "reason": "license text" },
    { "glob": "NOTICE", "category": "legacy-docs", "reason": "license notice" },
    { "glob": ".gitattributes", "category": "first-party-source", "docs": ["dev.dev-environments"] },
    { "glob": ".gitignore", "category": "first-party-source", "docs": ["dev.dev-environments"] },
    { "glob": "Cargo.toml", "category": "first-party-source", "docs": ["dev.repo-map"] },
    { "glob": "package.json", "category": "first-party-source", "docs": ["dev.repo-map", "dev.dev-environments"] },
    { "glob": "pnpm-workspace.yaml", "category": "first-party-source", "docs": ["dev.repo-map"] },
    { "glob": "rust-toolchain.toml", "category": "first-party-source", "docs": ["dev.dev-environments", "ref.compatibility"] }
  ]
}
