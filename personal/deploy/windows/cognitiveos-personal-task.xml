<?xml version="1.0" encoding="UTF-8"?>
<!--
  Source-controlled Personal per-user scheduled task template. This checked-in
  template is intentionally unrendered and must be rejected before
  installation. It is the Windows analog of the Linux user-systemd unit:
  per-user, least-privilege, interactive-token, loopback-only daemon start
  with restart-on-failure. It never elevates, never stores credentials, and
  never runs as SYSTEM.
  P11-T02: MultipleInstancesPolicy IgnoreNew refuses a duplicate daemon.
  This task is not a DSH web host shell and not a second credential plane.
  Tray presence is not proof of work. Same-disk automatic versions are
  local restore points, not disaster backups.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>CognitiveOS Personal daemon</Description>
    <URI>\CognitiveOS\cognitiveos-personal</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>@COGNITIVEOS_RELEASE_ROOT@\bin\kernel-server.exe</Command>
      <Arguments>--personal --bind 127.0.0.1:@COGNITIVEOS_PERSONAL_HEALTH_PORT@ --runtime-root @COGNITIVEOS_RUNTIME_ROOT@</Arguments>
    </Exec>
  </Actions>
</Task>
