{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-intent-interpret-result.schema.json",
  "title": "CognitiveOS TaskIntentInterpretResult",
  "description": "Daemon-issued persisted interpretation projection returned by intent.interpret. A candidate status is not an acceptance decision or TaskContract admission; material ambiguity remains clarification_required.",
  "type": "object",
  "required": ["schema_version", "interpretation_id", "status", "material_ambiguity_count", "interpretation_digest"],
  "properties": {
    "schema_version": {"const": "cognitiveos.task-intent-interpret-result/0.1"},
    "interpretation_id": {"$ref": "object-reference.schema.json#/$defs/uuidV7"},
    "status": {"enum": ["candidate", "clarification_required"]},
    "material_ambiguity_count": {"type": "integer", "minimum": 0},
    "interpretation_digest": {"$ref": "common-defs.schema.json#/$defs/digest"}
  },
  "additionalProperties": false
}
