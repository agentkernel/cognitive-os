{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-contract.schema.json",
  "title": "TaskContract",
  "type": "object",
  "required": [
    "header",
    "task_ref",
    "contract_epoch",
    "intent_acceptance_ref",
    "intent_interpretation_ref",
    "user_intent_ref",
    "objective",
    "scope",
    "conditions",
    "budget",
    "max_iterations",
    "max_retries",
    "allowed_state_domains",
    "allowed_tools"
  ],
  "properties": {
    "header": {
      "allOf": [
        {
          "$ref": "governed-object-header.schema.json"
        },
        {
          "properties": {
            "type": {
              "const": "TaskContract"
            }
          }
        }
      ]
    },
    "task_ref": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Task scope",
      "type": "object",
      "required": [
        "in_scope",
        "out_of_scope"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "additionalProperties": false
    },
    "conditions": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Contract condition",
        "type": "object",
        "required": [
          "id",
          "kind",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "acceptance",
              "stop",
              "escalation",
              "wait",
              "constraint"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "verifier_ref": {
            "type": "string",
            "format": "uri-reference",
            "minLength": 1
          },
          "machine_expression": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "budget": {
      "$ref": "common-defs.schema.json#/$defs/budget"
    },
    "max_iterations": {
      "type": "integer",
      "minimum": 1
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "description": "Absolute task-execution deadline. This is task authority, not an AKP request deadline."
    },
    "loop_object_id": {
      "$ref": "object-reference.schema.json#/$defs/uuidV7",
      "description": "Durable Loop lifecycle object identity bound by this immutable contract epoch."
    },
    "budget_id": {
      "$ref": "object-reference.schema.json#/$defs/uuidV7",
      "description": "Durable authority budget ledger identity bound by this immutable contract epoch."
    },
    "allowed_state_domains": {
      "type": "array",
      "description": "Authority-managed state domain names; the domain registry (specs/registry/state-domains.yaml) is open (domain_name_closed_enum: false), so values are registry domain identifiers, not a closed enum.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri-reference",
        "minLength": 1
      },
      "minItems": 0
    },
    "human_gates": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Human gate",
        "type": "object",
        "required": [
          "id",
          "trigger"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "approver": {
            "type": "string",
            "format": "uri-reference",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "user_intent_ref": {
      "$ref": "object-reference.schema.json#/$defs/strongReference"
    },
    "intent_interpretation_ref": {
      "$ref": "object-reference.schema.json#/$defs/strongReference"
    },
    "intent_acceptance_ref": {
      "$ref": "object-reference.schema.json#/$defs/strongReference"
    },
    "contract_epoch": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "description": "Only the explicitly supported historical and execution-bound schema versions are valid TaskContract payloads.",
      "properties": {
        "header": {
          "properties": {
            "schema_version": {
              "enum": [
                "cognitiveos.task-contract/0.1",
                "cognitiveos.task-contract/0.2"
              ]
            }
          },
          "required": [
            "schema_version"
          ]
        }
      },
      "required": [
        "header"
      ]
    },
    {
      "description": "Historical v0.1 contracts remain auditable but cannot contain execution bindings introduced by v0.2.",
      "if": {
        "properties": {
          "header": {
            "properties": {
              "schema_version": {
                "const": "cognitiveos.task-contract/0.1"
              }
            },
            "required": [
              "schema_version"
            ]
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "deadline"
              ]
            },
            {
              "required": [
                "loop_object_id"
              ]
            },
            {
              "required": [
                "budget_id"
              ]
            }
          ]
        }
      }
    },
    {
      "description": "Execution-bound v0.2 contracts require all authority bindings as one atomic set.",
      "if": {
        "properties": {
          "header": {
            "properties": {
              "schema_version": {
                "const": "cognitiveos.task-contract/0.2"
              }
            },
            "required": [
              "schema_version"
            ]
          }
        }
      },
      "then": {
        "required": [
          "deadline",
          "loop_object_id",
          "budget_id"
        ]
      }
    },
    {
      "description": "A TaskContract must declare at least one acceptance condition so completion is decidable.",
      "properties": {
        "conditions": {
          "contains": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "acceptance"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      }
    }
  ]
}
