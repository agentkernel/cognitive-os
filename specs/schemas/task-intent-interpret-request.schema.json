{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-intent-interpret-request.schema.json",
  "title": "CognitiveOS TaskIntentInterpretRequest",
  "description": "Authenticated candidate input for intent.interpret on the Task channel. The daemon derives interpretation identity, governance facts, correlation, and writer lease; the candidate is not accepted or admitted by this request.",
  "type": "object",
  "required": ["schema_version", "user_intent_record_id", "candidate"],
  "properties": {
    "schema_version": {"const": "cognitiveos.task-intent-interpret-request/0.1"},
    "user_intent_record_id": {"$ref": "object-reference.schema.json#/$defs/uuidV7"},
    "candidate": {
      "type": "object",
      "required": ["objectives", "constraints", "forbidden", "assumptions", "ambiguities", "information_gaps"],
      "properties": {
        "objectives": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "forbidden": {"type": "array", "items": {"type": "string"}},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "ambiguities": {"type": "array", "items": {"type": "object", "required": ["id", "material", "question"], "properties": {"id": {"type": "string", "minLength": 1}, "material": {"type": "boolean"}, "question": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
        "information_gaps": {"type": "array", "items": {"$ref": "common-defs.schema.json#/$defs/uriRef"}},
        "supersedes_interpretation_id": {"$ref": "object-reference.schema.json#/$defs/uuidV7"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
