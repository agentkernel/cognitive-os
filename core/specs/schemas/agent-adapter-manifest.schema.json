{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-adapter-manifest.schema.json",
  "title": "CognitiveOS AgentAdapterManifest",
  "description": "Public AKP-only agent adapter capability declaration. Candidate-only I/O is required; public listeners and authority writers are forbidden. Discovery metadata may align with A2A Agent Card field semantics without introducing a public network listener.",
  "type": "object",
  "required": [
    "schema_version",
    "adapter_id",
    "protocol",
    "candidate_only",
    "public_listener",
    "authority_writer",
    "discovery_card_digest",
    "declaration_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "cognitiveos.agent-adapter-manifest/0.1"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "const": "akp-http-json-sse"
    },
    "candidate_only": {
      "const": true
    },
    "public_listener": {
      "const": false
    },
    "authority_writer": {
      "const": false
    },
    "discovery_card_digest": {
      "$ref": "common-defs.schema.json#/$defs/digest"
    },
    "declaration_digest": {
      "$ref": "common-defs.schema.json#/$defs/digest"
    },
    "discovery": {
      "type": "object",
      "description": "Optional A2A-aligned local discovery metadata. Presence does not authorize a public listener.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
