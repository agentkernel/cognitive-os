{
  "schema": "cognitiveos-handbook-source-map/0.1",
  "description": "Docs-impact routing table. When a change touches paths matching `sources`, the listed doc_ids must be reviewed and updated (or regenerated when generated=true) in the same formal task and PR, or the PR must record a concrete `docs-impact: none` justification. Consumed by .cursor/rules/20-cognitiveos-personal-handbook-sync.mdc and by developers directly.",
  "rules": [
    {
      "id": "cli-product",
      "sources": ["apps/admin-cli/src/personal_cli/**", "apps/admin-cli/src/cognitive_main.rs"],
      "docs": ["ref.cli-cognitive", "user.cli-basics", "user.install-first-conversation", "user.operations-recovery"],
      "note": "cognitive verb set, flags, usage text, exit codes"
    },
    {
      "id": "cli-admin",
      "sources": ["apps/admin-cli/src/main.rs", "apps/admin-cli/src/lib.rs"],
      "docs": ["ref.cli-admin", "dev.management-plane"],
      "note": "admin-cli verbs, session gating, agent lifecycle commands"
    },
    {
      "id": "daemon-http",
      "sources": ["apps/kernel-server/src/personal/server.rs", "apps/kernel-server/src/personal/auth.rs", "apps/kernel-server/src/personal/bounds.rs", "apps/kernel-server/src/personal/task_api.rs", "apps/kernel-server/src/personal/resource_api.rs", "apps/kernel-server/src/personal/readiness.rs", "apps/kernel-server/src/personal/provider_proxy.rs", "apps/kernel-server/src/personal/*doctor*.rs"],
      "docs": ["ref.http-api", "dev.daemon-http-surface", "user.operations-recovery", "ai.validation-commands"],
      "note": "routes, channels, auth, limits, readiness/doctor projections"
    },
    {
      "id": "scheduler-execution",
      "sources": ["apps/kernel-server/src/personal/scheduler_authority/**", "apps/kernel-server/src/personal/tool_executor/**", "apps/kernel-server/src/personal/verification_executor.rs", "crates/cognitive-runtime/src/scheduler_service.rs"],
      "docs": ["dev.execution-chain-status", "dev.task-pipeline", "ref.capability-status"],
      "note": "execution wiring status is the most drift-sensitive handbook claim"
    },
    {
      "id": "kernel-authority",
      "sources": ["crates/cognitive-kernel/**", "crates/cognitive-domain/**"],
      "docs": ["dev.authority-kernel", "dev.context-artifact", "ref.transitions"],
      "note": "transition gate, intent chain, context pipeline, budgets, recovery"
    },
    {
      "id": "store",
      "sources": ["crates/cognitive-store/**"],
      "docs": ["dev.store-migrations", "dev.memory-skill", "user.operations-recovery"],
      "note": "migration map, authority vs derived data, backup planning APIs"
    },
    {
      "id": "secrets-provider",
      "sources": ["crates/cognitive-secret/**", "crates/cognitive-provider-transport/**"],
      "docs": ["user.provider-and-secrets", "user.security-boundaries", "ref.config-files", "ref.env-vars"],
      "note": "SecretStore backends, provider config, discovery, transport bounds"
    },
    {
      "id": "pi-shell",
      "sources": ["packages/pi-cognitiveos/**", "apps/pi-agent-adapter/**", "apps/kernel-server/src/personal/pi_runtime.rs"],
      "docs": ["user.pi-shell", "dev.agent-pi-lifecycle", "ref.env-vars"],
      "note": "Pi extension, daemon client, candidate path, launch admission"
    },
    {
      "id": "agent-lifecycle-installer",
      "sources": ["crates/cognitive-runtime/src/installer.rs", "crates/cognitive-runtime/src/agent_registration.rs", "crates/cognitive-runtime/src/linux_bundle*.rs", "crates/cognitive-runtime/src/bin/linux_bundle*.rs", "deploy/**"],
      "docs": ["user.install-first-conversation", "dev.installer-service", "dev.agent-pi-lifecycle"],
      "note": "bundle verify/stage/activate, single-service transaction, Pi acquisition/registration"
    },
    {
      "id": "ts-clients",
      "sources": ["packages/sdk-ts/**", "apps/agent-shell/**"],
      "docs": ["dev.clients-ts"],
      "note": "AKP envelopes, channels, watch, shell session"
    },
    {
      "id": "contracts",
      "sources": ["specs/**", "crates/cognitive-contracts/**", "packages/contracts-ts/**", "tests/golden/**"],
      "docs": ["ref.schemas", "ref.errors", "ref.transitions", "dev.contracts-codegen", "ai.source-of-truth"],
      "note": "registries, schemas, transitions, codegen, golden parity; contract changes also follow Lane-CTR"
    },
    {
      "id": "conformance-tools",
      "sources": ["conformance/**", "crates/cognitive-conformance/**", "tools/**", "tests/**"],
      "docs": ["dev.conformance-testing", "ai.validation-commands", "meta.sync-policy"],
      "note": "vectors, runner, checkers, gate evaluators"
    },
    {
      "id": "management",
      "sources": ["crates/cognitive-management/**"],
      "docs": ["dev.management-plane", "ref.cli-admin", "ref.errors"],
      "note": "fallback verbs, sessions, approvals, audit port, task application service"
    },
    {
      "id": "performance",
      "sources": ["crates/cognitive-runtime/src/perf.rs", "crates/cognitive-runtime/src/bin/p7_t04_module_benchmark.rs", "crates/cognitive-runtime/src/bin/p9_t01_async_decision_gate.rs", "crates/cognitive-runtime/src/campaign_*.rs", "crates/cognitive-runtime/src/performance_campaign.rs", "crates/cognitive-runtime/src/loopback_transport.rs", "crates/cognitive-runtime/src/resource_sampler.rs", "crates/cognitive-runtime/src/provider_route_policy.rs", "crates/cognitive-runtime/src/task_scenario_harness.rs"],
      "docs": ["dev.performance-perf"],
      "note": "hypothesis-only measurement surfaces; never benefit claims"
    },
    {
      "id": "ci-workflows",
      "sources": [".github/**", "package.json", "tools/package.json", "rust-toolchain.toml", "pnpm-workspace.yaml", "Cargo.toml"],
      "docs": ["dev.contributing-workflow", "dev.dev-environments", "ai.validation-commands", "ref.compatibility"],
      "note": "validation entry points and pins"
    },
    {
      "id": "handbook-itself",
      "sources": ["handbook/**", "llms.txt", ".cursor/rules/20-cognitiveos-personal-handbook-sync.mdc"],
      "docs": ["meta.doc-standards", "meta.sync-policy", "ai.entry"],
      "note": "changes here run the handbook checker and generator --check"
    }
  ]
}
