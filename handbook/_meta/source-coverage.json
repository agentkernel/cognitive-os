{
  "schema": "cognitiveos-handbook-coverage/0.1",
  "description": "Total classification of every Git-tracked repository path. tools/src/check-handbook.mjs expands `git ls-files` against these rules: every tracked path must match at least one rule (first match wins, top to bottom). A new first-party file that matches no rule fails the handbook check until it is classified here. Categories `excluded-*` need a reason; category `first-party-source` needs at least one owning doc_id; documentation categories point at their own system.",
  "categories": {
    "handbook": "the handbook system itself (validated by manifest/frontmatter checks)",
    "first-party-source": "live first-party implementation, contract, test, or tooling text mapped to handbook docs",
    "legacy-docs": "pre-existing documentation system (governance/plan/product/architecture/ADR/checkpoints/prompts); canonical or historical sources the handbook links to but never duplicates or edits",
    "excluded-lock-payload": "machine dependency lock payload without documentation semantics",
    "excluded-frozen-history": "frozen History/ archive; reading or citing is forbidden by repository governance",
    "generated-bindings": "committed generator output; regenerated, never hand-edited; described by dev.contracts-codegen"
  },
  "rules": [
    { "glob": "History/**", "category": "excluded-frozen-history", "reason": "docs/governance prohibition: never read or cite History/" },
    { "glob": "Cargo.lock", "category": "excluded-lock-payload", "reason": "cargo dependency lock; no documentation semantics" },
    { "glob": "pnpm-lock.yaml", "category": "excluded-lock-payload", "reason": "pnpm dependency lock; no documentation semantics" },

    { "glob": "handbook/**", "category": "handbook", "docs": ["meta.doc-standards"] },
    { "glob": "llms.txt", "category": "handbook", "docs": ["ai.entry"] },
    { "glob": ".githooks/**", "category": "first-party-source", "docs": ["meta.sync-policy", "ai.docs-impact", "dev.contributing-workflow"] },

    { "glob": "crates/cognitive-contracts/src/generated/**", "category": "generated-bindings", "docs": ["dev.contracts-codegen"] },
    { "glob": "packages/contracts-ts/src/generated/**", "category": "generated-bindings", "docs": ["dev.contracts-codegen"] },
    { "glob": "docs/traceability/matrix.yaml", "category": "generated-bindings", "docs": ["dev.conformance-testing"] },
    { "glob": "tests/golden/*.json", "category": "generated-bindings", "docs": ["dev.contracts-codegen"] },

    { "glob": "crates/cognitive-kernel/**", "category": "first-party-source", "docs": ["dev.authority-kernel", "dev.task-pipeline", "dev.context-artifact"] },
    { "glob": "crates/cognitive-store/**", "category": "first-party-source", "docs": ["dev.store-migrations", "dev.memory-skill", "dev.execution-chain-status"] },
    { "glob": "crates/cognitive-runtime/**", "category": "first-party-source", "docs": ["dev.installer-service", "dev.agent-pi-lifecycle", "dev.performance-perf", "dev.execution-chain-status"] },
    { "glob": "crates/cognitive-domain/**", "category": "first-party-source", "docs": ["dev.authority-kernel", "ref.transitions"] },
    { "glob": "crates/cognitive-akp/**", "category": "first-party-source", "docs": ["dev.clients-ts", "ref.http-api"] },
    { "glob": "crates/cognitive-management/**", "category": "first-party-source", "docs": ["dev.management-plane", "ref.cli-admin"] },
    { "glob": "crates/cognitive-secret/**", "category": "first-party-source", "docs": ["user.provider-and-secrets", "dev.daemon-http-surface"] },
    { "glob": "crates/cognitive-provider-transport/**", "category": "first-party-source", "docs": ["user.provider-and-secrets", "dev.daemon-http-surface"] },
    { "glob": "crates/cognitive-conformance/**", "category": "first-party-source", "docs": ["dev.conformance-testing"] },
    { "glob": "crates/cognitive-contracts/**", "category": "first-party-source", "docs": ["dev.contracts-codegen"] },

    { "glob": "apps/kernel-server/**", "category": "first-party-source", "docs": ["dev.daemon-http-surface", "dev.task-pipeline", "ref.http-api"] },
    { "glob": "apps/admin-cli/**", "category": "first-party-source", "docs": ["user.cli-basics", "ref.cli-cognitive", "ref.cli-admin"] },
    { "glob": "apps/pi-agent-adapter/**", "category": "first-party-source", "docs": ["dev.agent-pi-lifecycle", "user.pi-shell"] },
    { "glob": "apps/agent-shell/**", "category": "first-party-source", "docs": ["dev.clients-ts"] },
    { "glob": "apps/cognitiveos-console/**", "category": "legacy-docs", "reason": "deprecated compatibility stubs pointing at the external cognitiveos-clients repository (CLIENTS-DEC-001)" },

    { "glob": "packages/pi-cognitiveos/**", "category": "first-party-source", "docs": ["user.pi-shell", "dev.clients-ts"] },
    { "glob": "packages/dsh-akp-adapter/**", "category": "first-party-source", "docs": ["dev.agent-pi-lifecycle", "dev.performance-perf"] },
    { "glob": "packages/sdk-ts/**", "category": "first-party-source", "docs": ["dev.clients-ts"] },
    { "glob": "packages/contracts-ts/**", "category": "first-party-source", "docs": ["dev.contracts-codegen"] },

    { "glob": "specs/registry/**", "category": "first-party-source", "docs": ["ref.errors", "ref.schemas", "dev.contracts-codegen"] },
    { "glob": "specs/transitions/**", "category": "first-party-source", "docs": ["ref.transitions"] },
    { "glob": "specs/schemas/**", "category": "first-party-source", "docs": ["ref.schemas"] },
    { "glob": "specs/**", "category": "first-party-source", "docs": ["dev.architecture-overview", "ai.source-of-truth"] },

    { "glob": "conformance/**", "category": "first-party-source", "docs": ["dev.conformance-testing"] },
    { "glob": "tests/**", "category": "first-party-source", "docs": ["dev.dev-environments", "dev.conformance-testing"] },
    { "glob": "tools/**", "category": "first-party-source", "docs": ["dev.conformance-testing", "meta.sync-policy"] },
    { "glob": "deploy/**", "category": "first-party-source", "docs": ["user.install-first-conversation", "dev.installer-service"] },
    { "glob": "scripts/**", "category": "first-party-source", "docs": ["dev.dev-environments"] },
    { "glob": ".github/**", "category": "first-party-source", "docs": ["dev.contributing-workflow", "dev.dev-environments"] },
    { "glob": ".cursor/rules/**", "category": "legacy-docs", "reason": "editor adapter rules owned by repository governance; the handbook sync rule is registered separately" },

    { "glob": "docs/governance/**", "category": "legacy-docs", "reason": "canonical governance sources; handbook links, never duplicates" },
    { "glob": "docs/plan/**", "category": "legacy-docs", "reason": "formal plan, current snapshot, lease ledger, environments; dynamic status is never copied into the handbook" },
    { "glob": "docs/product/**", "category": "legacy-docs", "reason": "canonical stable product design" },
    { "glob": "docs/architecture/**", "category": "legacy-docs", "reason": "informative target architecture" },
    { "glob": "docs/adr/**", "category": "legacy-docs", "reason": "accepted/proposed decision records" },
    { "glob": "docs/standards/**", "category": "legacy-docs", "reason": "normative behavior standards; contract-class sources" },
    { "glob": "docs/checkpoints/**", "category": "legacy-docs", "reason": "dated evidence/handoffs; historical, not current status" },
    { "glob": "docs/prompts/**", "category": "legacy-docs", "reason": "dated non-executable prompts" },
    { "glob": "docs/evaluation/**", "category": "legacy-docs", "reason": "evaluation/benchmark design sources" },
    { "glob": "docs/traceability/**", "category": "legacy-docs", "reason": "traceability ledger and findings" },
    { "glob": "docs/legal/**", "category": "legacy-docs", "reason": "third-party notices" },
    { "glob": "docs/clients/**", "category": "legacy-docs", "reason": "deprecated stub pointing at external clients repository" },
    { "glob": "docs/platforms/**", "category": "legacy-docs", "reason": "deprecated stub pointing at external clients repository" },
    { "glob": "docs/research/**", "category": "legacy-docs", "reason": "documentation-only research reviews" },
    { "glob": "docs/README.md", "category": "legacy-docs", "reason": "legacy documentation map" },

    { "glob": "AGENTS.md", "category": "legacy-docs", "reason": "agent entry document; handbook adds one pointer only" },
    { "glob": "README.md", "category": "legacy-docs", "reason": "repository root readme" },
    { "glob": "plan.md", "category": "legacy-docs", "reason": "research/task-card detail source" },
    { "glob": "CognitiveOS-Architecture.md", "category": "legacy-docs", "reason": "informative whitepaper" },
    { "glob": "CognitiveOS-Architecture-Independent-Review.md", "category": "legacy-docs", "reason": "frozen historical review" },
    { "glob": "CognitiveOS-Review-Conclusions.md", "category": "legacy-docs", "reason": "frozen historical review" },
    { "glob": "RFC-0001-cognitiveos-governance-context-access.md", "category": "legacy-docs", "reason": "normative companion RFC" },
    { "glob": "LICENSE", "category": "legacy-docs", "reason": "license text" },
    { "glob": "NOTICE", "category": "legacy-docs", "reason": "license notice" },
    { "glob": ".gitattributes", "category": "first-party-source", "docs": ["dev.dev-environments"] },
    { "glob": ".gitignore", "category": "first-party-source", "docs": ["dev.dev-environments"] },
    { "glob": "Cargo.toml", "category": "first-party-source", "docs": ["dev.repo-map"] },
    { "glob": "package.json", "category": "first-party-source", "docs": ["dev.repo-map", "dev.dev-environments"] },
    { "glob": "pnpm-workspace.yaml", "category": "first-party-source", "docs": ["dev.repo-map"] },
    { "glob": "rust-toolchain.toml", "category": "first-party-source", "docs": ["dev.dev-environments", "ref.compatibility"] }
  ]
}
